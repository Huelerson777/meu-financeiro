# Banco de Dados (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/financeflow?schema=public"

# JWT
JWT_SECRET="troque-este-valor-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-valor-tambem"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Rate limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# E-mail (recuperação de senha). Se SMTP_HOST não for definido, o e-mail
# só é logado no console em vez de enviado de verdade (útil em dev).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FinanceFlow <no-reply@financeflow.app>"
