# Banco de Dados (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/financeflow?schema=public"

# JWT
JWT_SECRET="troque-este-valor-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-valor-tambem"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Rate limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# E-mail (recuperação de senha). Se SMTP_HOST não for definido, o e-mail
# só é logado no console em vez de enviado de verdade (útil em dev).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FinanceFlow <no-reply@financeflow.app>"

# WhatsApp (lançamento de transações via mensagem — ver docs/ENVIRONMENT.md)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="escolha-uma-string-qualquer-e-repita-no-dashboard-da-meta"

# Anthropic (interpreta texto/imagem das mensagens do WhatsApp)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
