# Banco de Dados (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/poupay?schema=public"

# JWT
JWT_SECRET="troque-este-valor-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-valor-tambem"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Rate limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# E-mail transacional (verificação de cadastro e recuperação de senha). Se
# SMTP_HOST não for definido, o e-mail só é logado no console (útil em dev —
# o código de verificação aparece no log do backend).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=usepoupay@gmail.com
# e SMTP_PASS = "senha de app" (exige verificação em 2 etapas na conta Google).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PouPay <usepoupay@gmail.com>"

# WhatsApp (lançamento de transações via mensagem — ver docs/ENVIRONMENT.md)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN="escolha-uma-string-qualquer-e-repita-no-dashboard-da-meta"

# Anthropic (interpreta texto/imagem das mensagens do WhatsApp)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# brapi.dev (cotação de ações/fundos nas posições de investimento). Cadastro
# gratuito em https://brapi.dev/dashboard. Sem isso, ações/fundos com ticker
# não atualizam o preço automaticamente (fica manual).
BRAPI_API_TOKEN=""

# Open Finance via Pluggy (Meu Pluggy). Credenciais em https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# Segredo do webhook da Pluggy (header x-webhook-secret). Gere um valor aleatório longo.
PLUGGY_WEBHOOK_SECRET=""
